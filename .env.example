# Talkie signaling configuration placeholders. Never commit real credentials.

# Development uses loopback automatically. Packaged builds REQUIRE an explicit
# real public wss:// URL; leave unset until an actual endpoint is verified.
# VITE_SIGNALING_URL=

# Signaling server
HOST=127.0.0.1
PORT=8787
ALLOWED_ORIGINS=http://localhost:5173,http://tauri.localhost
ROOM_TTL_SECONDS=3600
HEARTBEAT_INTERVAL_SECONDS=15
HEARTBEAT_TIMEOUT_SECONDS=45
MAX_MESSAGE_BYTES=65536
# Hard maximum hold duration; no renewal or automatic continuation.
FLOOR_LEASE_SECONDS=30
RATE_LIMIT_WINDOW_SECONDS=10
MAX_MESSAGES_PER_WINDOW=100
MAX_SOCKETS=2000
MAX_ROOMS=1000
MAX_IP_ENTRIES=10000
MAX_UPGRADES_PER_WINDOW=60
MAX_CREATES_PER_WINDOW=20
MAX_JOINS_PER_WINDOW=60

# Server ICE settings. Blank TURN fields are invalid: omit them entirely when
# doing STUN-only testing. Do NOT put the TURN secret into any VITE_* variable.
STUN_URL=stun:stun.l.google.com:19302
# TURN_URL accepts comma-separated turn:/turns: URIs on a verified relay host.
# TURN_URL=
# TURN_SHARED_SECRET=
# TURN_CREDENTIAL_TTL_SECONDS=3900
# Dynamic credential TTL must exceed ROOM_TTL_SECONDS by at least 60 seconds.
# Legacy TURN_USERNAME/TURN_CREDENTIAL are allowed in development ONLY;
# do not set them in production or combine them with the shared-secret mode.
